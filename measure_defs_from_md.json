[
    {
        "name":  "Total Personagens",
        "expression":  "COUNTROWS(dim_character)"
    },
    {
        "name":  "Total Episódios",
        "expression":  "COUNTROWS(dim_episode)"
    },
    {
        "name":  "Total Localizações",
        "expression":  "COUNTROWS(dim_location)"
    },
    {
        "name":  "Total Dimensões",
        "expression":  "DISTINCTCOUNT(dim_location[dimension])"
    },
    {
        "name":  "Avg Personagens por Episódio",
        "expression":  "DIVIDE(\r\n    COUNTROWS(fact_character_episode),\r\n    COUNTROWS(dim_episode),\r\n    0\r\n)"
    },
    {
        "name":  "Personagens Mudaram Dimensão",
        "expression":  "CALCULATE(\r\n    COUNTROWS(dim_character),\r\n    dim_character[Mudou Dimensão] = \"Sim\"\r\n)"
    },
    {
        "name":  "Personagens Não Mudaram Dimensão",
        "expression":  "CALCULATE(\r\n    COUNTROWS(dim_character),\r\n    dim_character[Mudou Dimensão] = \"Não\"\r\n)"
    },
    {
        "name":  "% Mudou Dimensão",
        "expression":  "DIVIDE(\r\n    [Personagens Mudaram Dimensão],\r\n    [Total Personagens],\r\n    0\r\n)"
    },
    {
        "name":  "Humanos Vivos",
        "expression":  "CALCULATE(\r\n    COUNTROWS(dim_character),\r\n    dim_character[species] = \"Human\",\r\n    dim_character[status] = \"Alive\"\r\n)"
    },
    {
        "name":  "Humanos Mortos",
        "expression":  "CALCULATE(\r\n    COUNTROWS(dim_character),\r\n    dim_character[species] = \"Human\",\r\n    dim_character[status] = \"Dead\"\r\n)"
    },
    {
        "name":  "Aliens Vivos",
        "expression":  "CALCULATE(\r\n    COUNTROWS(dim_character),\r\n    dim_character[species] = \"Alien\",\r\n    dim_character[status] = \"Alive\"\r\n)"
    },
    {
        "name":  "Aliens Mortos",
        "expression":  "CALCULATE(\r\n    COUNTROWS(dim_character),\r\n    dim_character[species] = \"Alien\",\r\n    dim_character[status] = \"Dead\"\r\n)"
    },
    {
        "name":  "Personagens Masculino",
        "expression":  "CALCULATE(\r\n    COUNTROWS(dim_character),\r\n    dim_character[gender] = \"Male\"\r\n)"
    },
    {
        "name":  "Personagens Feminino",
        "expression":  "CALCULATE(\r\n    COUNTROWS(dim_character),\r\n    dim_character[gender] = \"Female\"\r\n)"
    },
    {
        "name":  "Personagens Gênero Unknown",
        "expression":  "CALCULATE(\r\n    COUNTROWS(dim_character),\r\n    dim_character[gender] = \"Unknown\"\r\n)"
    },
    {
        "name":  "Rank Espécie",
        "expression":  "RANKX(\r\n    ALL(dim_character[species]),\r\n    CALCULATE(COUNTROWS(dim_character)),\r\n    ,\r\n    DESC,\r\n    DENSE\r\n)"
    },
    {
        "name":  "Rank Personagem por Episódios",
        "expression":  "RANKX(\r\n    ALL(dim_character[name]),\r\n    dim_character[episode_count],\r\n    ,\r\n    DESC,\r\n    DENSE\r\n)"
    },
    {
        "name":  "Rank Dimensão Origem (Characters)",
        "expression":  "RANKX(\r\n    ALL(dim_character[origin_dimension]),\r\n    CALCULATE(COUNTROWS(dim_character)),\r\n    ,\r\n    DESC,\r\n    DENSE\r\n)"
    },
    {
        "name":  "Total Personagens Distintos",
        "expression":  "DISTINCTCOUNT(fact_character_episode[character_id])"
    },
    {
        "name":  "Total Episódios por Personagem",
        "expression":  "DISTINCTCOUNT(fact_character_episode[episode_id])"
    },
    {
        "name":  "Total Temporadas",
        "expression":  "DISTINCTCOUNT(dim_episode[season])"
    },
    {
        "name":  "Rank Episódio por Personagens",
        "expression":  "RANKX(\r\n    ALL(dim_episode[name]),\r\n    CALCULATE(DISTINCTCOUNT(fact_character_episode[character_id])),\r\n    ,\r\n    DESC,\r\n    DENSE\r\n)"
    },
    {
        "name":  "Personagens por Episódio (Distinct)",
        "expression":  "DISTINCTCOUNT(fact_character_episode[character_id])"
    },
    {
        "name":  "Personagens por Temporada (Distinct)",
        "expression":  "DISTINCTCOUNT(fact_character_episode[character_id])"
    },
    {
        "name":  "Avg Residentes por Localização",
        "expression":  "DIVIDE(\r\n    COUNTROWS(dim_character),\r\n    DISTINCTCOUNT(dim_location[name]),\r\n    0\r\n)"
    },
    {
        "name":  "Rank Localização por Residentes",
        "expression":  "RANKX(\r\n    ALL(dim_location[name]),\r\n    dim_location[resident_count],\r\n    ,\r\n    DESC,\r\n    DENSE\r\n)"
    },
    {
        "name":  "Rank Dimensão por Localizações",
        "expression":  "RANKX(\r\n    ALL(dim_location[dimension]),\r\n    CALCULATE(COUNTROWS(dim_location)),\r\n    ,\r\n    DESC,\r\n    DENSE\r\n)"
    },
    {
        "name":  "Rank Dimensão por Local (Locations)",
        "expression":  "RANKX(\r\n    ALL(dim_location[dimension]),\r\n    CALCULATE(COUNTROWS(dim_location)),\r\n    ,\r\n    DESC,\r\n    DENSE\r\n)"
    },
    {
        "name":  "Total Residentes",
        "expression":  "SUMPRODUCT(dim_location[resident_count])"
    },
    {
        "name":  "Personagens Vivos",
        "expression":  "CALCULATE(\r\n    COUNTROWS(dim_character),\r\n    dim_character[status] = \"Alive\"\r\n)"
    },
    {
        "name":  "Personagens Mortos",
        "expression":  "CALCULATE(\r\n    COUNTROWS(dim_character),\r\n    dim_character[status] = \"Dead\"\r\n)"
    },
    {
        "name":  "Personagens Status Unknown",
        "expression":  "CALCULATE(\r\n    COUNTROWS(dim_character),\r\n    dim_character[status] = \"Unknown\"\r\n)"
    },
    {
        "name":  "% Personagens Mortos (Total)",
        "expression":  "DIVIDE(\r\n    [Personagens Mortos],\r\n    [Total Personagens],\r\n    0\r\n)"
    },
    {
        "name":  "Tempo Médio Permanence (Episódios)",
        "expression":  "AVERAGE(dim_character[episode_count])"
    },
    {
        "name":  "Rank Dimensões Origem",
        "expression":  "RANKX(\r\n    ALL(dim_character[origin_dimension]),\r\n    CALCULATE(COUNTROWS(dim_character), dim_character[origin_dimension]),\r\n    ,\r\n    DESC,\r\n    DENSE\r\n)"
    },
    {
        "name":  "% Mortos por Espécie",
        "expression":  "DIVIDE(\r\n    CALCULATE(\r\n        COUNTROWS(dim_character),\r\n        dim_character[status] = \"Dead\"\r\n    ),\r\n    COUNTROWS(dim_character),\r\n    0\r\n)"
    },
    {
        "name":  "Rank Dimensão Origem (Análises)",
        "expression":  "RANKX(\r\n    ALL(dim_character[origin_dimension]),\r\n    CALCULATE(COUNTROWS(dim_character)),\r\n    ,\r\n    DESC,\r\n    DENSE\r\n)"
    },
    {
        "name":  "Personagens Introduzidos",
        "expression":  "COUNTROWS(dim_character)"
    }
]
